meta {
  name: Update User
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/user/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "firstName": "Jane",
    "lastName": "Doe",
    "isAdmin": false
  }
}

docs {
  Admin only. Accepted fields: firstName, lastName, email, isAdmin — any other field answers 400.
  "lastName": null clears the last name. avatar is not accepted: see Remove User Avatar.
}
