meta {
  name: Change My Password
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "currentPassword": "password",
    "newPassword": "NewPassword1"
  }
}

script:post-response {
  // Every earlier token is revoked: keep the fresh one for the next requests.
  if (res.status === 200) {
    bru.setVar("token", res.body.token);
  }
}
