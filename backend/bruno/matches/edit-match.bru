    "status": "PLAYED",
    "area": {
      "id": "area-id-here",
      "name": "Stade Municipal",
      "address": "1 rue du Stade",
      "city": "Paris",
      "longitude": 2.3522,
      "latitude": 48.8566
    },
    "homeGoals": 2,
    "awayGoals": 1
  }
}
