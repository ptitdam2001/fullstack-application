{
  "name": "application-material",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "(cd ../design-system && pnpm build) && vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen:sdk": "orval --config ./orval.config.ts",
    "test": "vitest --project=unit",
    "test:stories": "vitest --project=storybook",
    "test:ui": "vitest --ui --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:types": "tsc -b",
    "check:format": "prettier -c .",
    "check:lint": "eslint .",
    "check:dead-code": "knip",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@repo/design-system": "workspace:*",
    "@repo/form-factory": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-query-devtools": "5.91.3",
    "axios": "1.20.0",
    "country-flag-icons": "^1.6.20",
    "dayjs": "^1.11.23",
    "flat": "^6.0.1",
    "lucide-react": "^1.40.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-intl": "8.1.3",
    "react-router": "7.13.1",
    "recharts": "^3.10.1",
    "tailwind-scrollbar": "4.0.2",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.2",
    "zod": "4.5.4"
  },
  "prettier": "@repo/prettier-config",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.62.1",
    "@repo/eslint-config": "file:../../tooling/eslint-config",
    "@repo/prettier-config": "file:../../tooling/prettier-config",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^25.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "4.1.5",
    "@vitest/browser-playwright": "4.1.5",
    "@vitest/coverage-v8": "4.1.5",
    "@vitest/ui": "4.1.5",
    "autoprefixer": "10.5.4",
    "eslint": "10.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "eslint-plugin-storybook": "10.6.0",
    "globals": "17.12.0",
    "jsdom": "28.1.0",
    "knip": "^6.34.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "orval": "8.27.0",
    "playwright": "1.62.1",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "10.6.0",
    "storybook-addon-remix-react-router": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "overrides": {
    "storybook": "$storybook"
  },
  "engines": {
    "node": ">=10",
    "pnpm": ">=3"
  }
}
