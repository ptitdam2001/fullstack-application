staged=$(git diff --cached --name-only)

if echo "$staged" | grep -qE '^backend/(openapi\.yml|prisma/schema\.prisma)$'; then
  if [ ! -x backend/node_modules/.bin/tsx ]; then
    echo 'pre-commit: tsx is not installed, the openapi.yml / schema.prisma sync cannot be checked.' >&2
    echo 'pre-commit: run "pnpm install" in backend/, then commit again.' >&2
    exit 1
  fi

  (cd backend && pnpm check:sync-schema)
fi

# Same scope as the root check:format: backend/ and frontend/ check their own files.
staged_markdown() {
  git diff --cached --name-only --diff-filter=ACMR "$@" -- '*.md' ':!backend/' ':!frontend/'
}

if [ -n "$(staged_markdown)" ]; then
  if [ ! -x node_modules/.bin/prettier ]; then
    echo 'pre-commit: Prettier is not installed, the staged Markdown files cannot be checked.' >&2
    echo 'pre-commit: run "pnpm install" at the repository root, then commit again.' >&2
    exit 1
  fi

  if ! staged_markdown -z | xargs -0 node_modules/.bin/prettier --check --; then
    echo 'pre-commit: fix the files above with "npx prettier --write <file>", stage them, then commit again.' >&2
    exit 1
  fi
fi
